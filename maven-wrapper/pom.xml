<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.maven.wrapper</groupId>
    <artifactId>maven-wrapper-parent</artifactId>
    <version>3.3.5-SNAPSHOT</version>
  </parent>

  <artifactId>maven-wrapper</artifactId>

  <name>Maven Wrapper Jar</name>
  <description>Maven Wrapper Jar download, installs and launches installed target Maven distribution as part of Maven Wrapper scripts run.</description>

  <dependencies>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>3.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>4.11.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>apache-release</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-assembly-plugin</artifactId>
            <executions>
              <execution>
                <id>source-release-assembly</id>
                <configuration>
                  <skipAssembly>false</skipAssembly>
                  <runOnlyAtExecutionRoot>false</runOnlyAtExecutionRoot>
                  <archiveBaseDirectory>../</archiveBaseDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- MWRAPPER-117: publish the checksums of maven-wrapper.jar, so that the
               wrapperSha256Sum / wrapperSha512Sum properties can be filled in from an
               official source. The parent only checksums the source release. -->
          <plugin>
            <groupId>net.nicoulaj.maven.plugins</groupId>
            <artifactId>checksum-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>wrapper-jar-checksum</id>
                <goals>
                  <goal>artifacts</goal>
                </goals>
                <!-- run before maven-gpg-plugin:sign, see the parent's source-release-checksum -->
                <phase>post-integration-test</phase>
                <configuration>
                  <algorithms>
                    <algorithm>SHA-256</algorithm>
                    <algorithm>SHA-512</algorithm>
                  </algorithms>
                  <!-- only the wrapper jar itself; the source release is handled by the parent -->
                  <excludeClassifiers>sources,javadoc,cyclonedx,source-release</excludeClassifiers>
                  <csvSummary>false</csvSummary>
                  <attachChecksums>true</attachChecksums>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
